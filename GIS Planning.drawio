        <mxCell id="3cTtt3uPs2pEaFsk9B-T-3" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Sign-up Form:&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;- Username&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;- Contact Number&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;- User Type&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;- Sector&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;- Set Password&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;- Re-enter Password&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="309" y="70" width="190" height="210" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-4" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;User has two types:&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;1. normal_user&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;2. service_provider&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="579" y="70" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-5" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Home Screen Layout&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Rendered Map&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Buttons to Focus to Current Location&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Profile Button to Toggle Sidebar&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="79" y="350" width="310" height="130" as="geometry" />
