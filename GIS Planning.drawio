        <mxCell id="3cTtt3uPs2pEaFsk9B-T-27" value="Replace the red marker with an orange marker to the map frontend." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
