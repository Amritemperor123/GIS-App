        <mxCell id="3cTtt3uPs2pEaFsk9B-T-23" value="&lt;div&gt;jobs.state = 4&lt;/div&gt;&lt;div&gt;jobs.key = 1&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;marker.state = 4&lt;/div&gt;&lt;div&gt;append the new uploaded image at marker.image_array[]&lt;/div&gt;&lt;div&gt;marker.key = 1&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;New notification has been added to the table &quot;Notification&quot;.&lt;/div&gt;&lt;div&gt;notification.state = 2&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;notification.target = normal_user who uploaded the job to the map&lt;/span&gt;&lt;/div&gt;&lt;div&gt;notification.recipient_id =&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;normal_user who uploaded the job to the map&lt;/span&gt;&lt;/div&gt;&lt;div&gt;notification.key = 1&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
