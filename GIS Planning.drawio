        <mxCell id="3cTtt3uPs2pEaFsk9B-T-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3cTtt3uPs2pEaFsk9B-T-18" target="3cTtt3uPs2pEaFsk9B-T-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-18" value="New Job created at table &quot;Jobs&quot;.&lt;div&gt;jobs.key = 0&lt;/div&gt;&lt;div&gt;jobs.state = 1&lt;/div&gt;&lt;div&gt;jobs.created_by = user_id of the user who uploaded the photo to the map&lt;/div&gt;&lt;div&gt;jobs.accepted_by = NULL&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;A new Marker has been created on the location of upload inside the table &quot;Marker&quot;.&lt;/div&gt;&lt;div&gt;marker.state = 1&lt;/div&gt;&lt;div&gt;append the uploaded image at marker.image_array[]&lt;/div&gt;&lt;div&gt;marker.key = 0&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;New notification has been added to the table &quot;Notification&quot;.&lt;/div&gt;&lt;div&gt;notification.target = service_provider (all with the same sector as the location)&lt;/div&gt;&lt;div&gt;notification.state = 1&lt;/div&gt;&lt;div&gt;notification.recipient_id = NULL&lt;/div&gt;&lt;div&gt;notification.key = 0&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="89" y="990" width="240" height="340" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3cTtt3uPs2pEaFsk9B-T-20" target="3cTtt3uPs2pEaFsk9B-T-27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-20" value="&lt;div&gt;jobs.state = 2&lt;/div&gt;&lt;div&gt;jobs.accepted_by = user_id of the service_provider who accepted the job request.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;marker.state = 2&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;New notification has been added to the table &quot;Notification&quot;.&lt;/div&gt;&lt;div&gt;notification.state = 2&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;notification.target = service_provider (all with the same sector as the location)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;notification.recipient_id = user_id of the service_provider who accepted the job request.&lt;/div&gt;&lt;div&gt;notification.key = 1&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Delete the previous notification (when Marker Status was 1) from database.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="339" y="990" width="240" height="340" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3cTtt3uPs2pEaFsk9B-T-22" target="3cTtt3uPs2pEaFsk9B-T-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-22" value="&lt;div&gt;jobs.state = 3&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;marker.state = 3&lt;/div&gt;&lt;div&gt;append the new uploaded image at marker.image_array[]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;New notification has been added to the table &quot;Notification&quot;.&lt;/div&gt;&lt;div&gt;notification.state = 2&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;notification.target = normal_user who uploaded the job to the map&lt;/span&gt;&lt;/div&gt;&lt;div&gt;notification.recipient_id = NULL&lt;/div&gt;&lt;div&gt;notification.key = 1&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="589" y="990" width="240" height="340" as="geometry" />
