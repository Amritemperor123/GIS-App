        <mxCell id="3cTtt3uPs2pEaFsk9B-T-29" value="Replace the yellow marker with a green marker to the map frontend.&lt;div&gt;Display the array of three images in the popup menu.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
