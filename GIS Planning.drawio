        <mxCell id="3cTtt3uPs2pEaFsk9B-T-13" value="&lt;b&gt;Marker State: &lt;/b&gt;1&lt;div&gt;&lt;b&gt;Marker Color:&lt;/b&gt; Red&lt;br&gt;&lt;div&gt;&lt;b&gt;Description: &lt;/b&gt;An photo has been uploaded in the map by a normal_user and the location of the photo upload has been marked Red at the map.&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Backend: &lt;/b&gt;A new job has been created at the location of the photo upload. Notification is sent to all the service provider of the sector inside which the location falls.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Notification:&lt;/b&gt; A new job is available. Accept the job?&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="89" y="730" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3cTtt3uPs2pEaFsk9B-T-14" target="3cTtt3uPs2pEaFsk9B-T-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-14" value="&lt;b&gt;Marker State: &lt;/b&gt;2&lt;div&gt;&lt;b&gt;Marker Color:&lt;/b&gt;&amp;nbsp;Orange&lt;br&gt;&lt;div&gt;&lt;b&gt;Description: &lt;/b&gt;A service_provider has accepted the job request.&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Backend: &lt;/b&gt;The service_providers of that sector is notified about the closing of the job.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Notification:&lt;/b&gt; The job at location {{location}} has been accepted by user {{user}}.&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="339" y="730" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3cTtt3uPs2pEaFsk9B-T-15" target="3cTtt3uPs2pEaFsk9B-T-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-15" value="&lt;b&gt;Marker State: &lt;/b&gt;3&lt;div&gt;&lt;b&gt;Marker Color:&lt;/b&gt;&amp;nbsp;Yellow&lt;br&gt;&lt;div&gt;&lt;b&gt;Description: &lt;/b&gt;The service_provider who accepted the job request has reached the location and uploaded a photo (on the same location) as a proof that they&#39;ve started working.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Backend: &lt;/b&gt;The normal_user who uploaded the job has been notified about the beginning of work.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Notification:&lt;/b&gt; The work at location {{location}} has been started by user {{user}}.&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="589" y="730" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3cTtt3uPs2pEaFsk9B-T-16" target="3cTtt3uPs2pEaFsk9B-T-23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-16" value="&lt;b&gt;Marker State: &lt;/b&gt;4&lt;div&gt;&lt;b&gt;Marker Color:&lt;/b&gt;&amp;nbsp;Green&lt;br&gt;&lt;div&gt;&lt;b&gt;Description: &lt;/b&gt;The job has been completed and the service_provider has uploaded a photo of the completed job at the same location.&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Backend: &lt;/b&gt;The job has been marked as done, and a notification to the normal_user who uploaded the job has been sent.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Notification:&lt;/b&gt; The job at location {{location}} has been completed by user {{user}}. Rate their work.&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="839" y="730" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="3cTtt3uPs2pEaFsk9B-T-17" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Markers and Their Functionalities&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="411.5" y="660" width="345" height="60" as="geometry" />
